<section id="workspace-metrics" class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-labelledby="metrics-heading" aria-live="polite">
  <h2 id="metrics-heading" class="sr-only">Workspace metrics</h2>

  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Total tasks</p>
    <p class="mt-3 text-3xl font-black tracking-tight text-slate-950"><%= metrics[:total] %></p>
    <p class="mt-1 text-sm text-slate-500">Current delivery queue</p>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">In motion</p>
    <p class="mt-3 text-3xl font-black tracking-tight text-violet-700"><%= metrics[:active] %></p>
    <p class="mt-1 text-sm text-slate-500">Tasks still active</p>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between gap-3">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Progress</p>
      <span class="text-sm font-bold text-emerald-700"><%= metrics[:progress] %>%</span>
    </div>
    <div
      class="mt-4 h-2.5 overflow-hidden rounded-full bg-slate-100"
      role="progressbar"
      aria-label="Task completion"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="<%= metrics[:progress] %>"
    >
      <div class="h-full rounded-full bg-gradient-to-r from-emerald-500 to-teal-400 transition-all" style="width: <%= metrics[:progress] %>%"></div>
    </div>
    <p class="mt-3 text-sm text-slate-500"><%= metrics[:completed] %> of <%= metrics[:total] %> completed</p>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Requests</p>
    <p class="mt-3 text-3xl font-black tracking-tight text-cyan-700"><%= counter %></p>
    <p class="mt-1 text-sm text-slate-500">Manual server round-trips</p>
  </div>
</section>
