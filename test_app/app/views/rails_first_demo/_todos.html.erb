<% task_edit_errors = local_assigns.fetch(:edit_errors, {}) %>
<% task_edit_values = local_assigns.fetch(:edit_values, {}) %>

<section id="rails-todos" class="px-6 py-2 sm:px-8" aria-label="Task list" aria-live="polite">
  <% if todos.any? %>
    <ul class="divide-y divide-slate-100" role="list">
      <% todos.each do |todo| %>
        <% todo_id = todo["id"] %>
        <% completed = todo["completed"] %>
        <% edit_error = task_edit_errors[todo_id] %>
        <% edit_value = task_edit_values.fetch(todo_id, todo["text"]) %>

        <li id="todo-<%= todo_id %>" class="py-5">
          <div class="flex items-start gap-4">
            <%= button_to toggle_rails_first_demo_todo_path(todo_id),
              method: :patch,
              class: "mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border-2 transition focus:outline-none focus:ring-4 focus:ring-violet-100 #{completed ? 'border-emerald-500 bg-emerald-500 text-white' : 'border-slate-300 bg-white text-transparent hover:border-violet-500'}",
              aria: { label: completed ? "Reopen #{todo['text']}" : "Complete #{todo['text']}", pressed: completed } do %>
              <svg viewBox="0 0 20 20" class="h-4 w-4" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="m4 10 3.5 3.5L16 5.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            <% end %>

            <div class="min-w-0 flex-1">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                <div class="min-w-0">
                  <p class="break-words text-sm font-semibold <%= completed ? 'text-slate-600 line-through' : 'text-slate-900' %>"><%= todo["text"] %></p>
                  <p class="mt-1 text-xs font-medium <%= completed ? 'text-emerald-700' : 'text-amber-700' %>">
                    <%= completed ? "Completed" : "Ready to work" %>
                  </p>
                </div>

                <div class="flex shrink-0 items-center gap-2">
                  <details class="group" <%= "open" if edit_error.present? %>>
                    <summary class="cursor-pointer list-none rounded-lg px-3 py-1.5 text-xs font-bold text-slate-600 transition hover:bg-slate-100 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-violet-300">
                      Edit task
                    </summary>
                    <div class="mt-3 w-full rounded-2xl border border-slate-200 bg-slate-50 p-4 sm:w-80">
                      <%= form_with url: update_rails_first_demo_todo_path(todo_id), method: :patch, class: "space-y-3" do |form| %>
                        <%= form.label :todo_text,
                          "Rename task",
                          for: "edit-todo-#{todo_id}",
                          class: "block text-xs font-bold uppercase tracking-wide text-slate-600" %>
                        <%= form.text_field :todo_text,
                          value: edit_value,
                          id: "edit-todo-#{todo_id}",
                          maxlength: RailsFirstDemoController::MAX_TODO_LENGTH,
                          required: true,
                          autocomplete: "off",
                          aria: { invalid: edit_error.present?, describedby: edit_error.present? ? "edit-error-#{todo_id}" : nil },
                          class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none focus:border-violet-500 focus:ring-4 focus:ring-violet-100" %>
                        <% if edit_error.present? %>
                          <p id="edit-error-<%= todo_id %>" class="text-xs font-medium text-rose-700" role="alert"><%= edit_error %></p>
                        <% end %>
                        <%= form.submit "Save changes", class: "cursor-pointer rounded-lg bg-violet-700 px-3 py-2 text-xs font-bold text-white hover:bg-violet-800" %>
                      <% end %>
                    </div>
                  </details>

                  <%= button_to "Delete",
                    delete_todo_path(todo_id),
                    method: :delete,
                    class: "rounded-lg px-3 py-1.5 text-xs font-bold text-rose-700 transition hover:bg-rose-50 focus:outline-none focus:ring-2 focus:ring-rose-200",
                    form: { data: { turbo_confirm: "Remove this task?" } },
                    aria: { label: "Delete #{todo['text']}" } %>
                </div>
              </div>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="py-14 text-center">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-50 text-2xl" aria-hidden="true">✓</div>
      <h3 class="mt-4 text-base font-bold text-slate-900">Queue cleared</h3>
      <p class="mt-1 text-sm text-slate-500">Add a task above when the next priority arrives.</p>
    </div>
  <% end %>
</section>
