<% content_for :title, "Rails-first Workspace" %>

<div class="w-full pb-16 text-slate-900">
  <section class="relative overflow-hidden rounded-[2rem] bg-slate-950 px-6 py-10 text-white shadow-2xl sm:px-10 lg:px-12">
    <div class="absolute -right-24 -top-28 h-80 w-80 rounded-full bg-cyan-400/20 blur-3xl" aria-hidden="true"></div>
    <div class="absolute -bottom-32 left-1/3 h-72 w-72 rounded-full bg-violet-500/20 blur-3xl" aria-hidden="true"></div>

    <div class="relative flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <div class="mb-5 flex flex-wrap items-center gap-3 text-xs font-semibold uppercase tracking-[0.22em] text-cyan-200">
          <span class="rounded-full border border-cyan-300/30 bg-cyan-300/10 px-3 py-1">Flagship demo</span>
          <span>Rails · Turbo · Session state</span>
        </div>
        <h1 class="text-4xl font-black tracking-tight sm:text-5xl lg:text-6xl">Rails-first workspace</h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-300 sm:text-lg">
          A complete server-rendered workflow: validated CRUD, live metrics, activity history,
          and catalog discovery—all progressively enhanced by Turbo Streams.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <%= link_to "Back to demos", root_path,
          class: "rounded-xl border border-white/20 px-4 py-2.5 text-sm font-semibold text-white transition hover:border-white/40 hover:bg-white/10" %>
        <span class="inline-flex items-center gap-2 rounded-xl bg-emerald-400/10 px-4 py-2.5 text-sm font-semibold text-emerald-200 ring-1 ring-inset ring-emerald-400/30">
          <span class="h-2 w-2 rounded-full bg-emerald-300" aria-hidden="true"></span>
          Server online
        </span>
      </div>
    </div>
  </section>

  <div class="mt-8">
    <%= render "metrics", metrics: @metrics, counter: @counter %>
  </div>

  <div class="mt-8 grid gap-8 xl:grid-cols-[minmax(0,1.65fr)_minmax(20rem,0.75fr)]">
    <section class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm" aria-labelledby="tasks-heading">
      <div class="border-b border-slate-100 px-6 py-6 sm:px-8">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-violet-600">Delivery queue</p>
            <h2 id="tasks-heading" class="mt-2 text-2xl font-bold tracking-tight text-slate-950">Team tasks</h2>
            <p class="mt-1 text-sm text-slate-500">Create, complete, rename, and remove work without a client-side store.</p>
          </div>
          <span class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-600">
            Session scoped
          </span>
        </div>

        <div class="mt-6">
          <%= render "todo_form", error: @todo_form_error, value: @todo_form_value %>
        </div>
      </div>

      <%= render "todos",
        todos: @todos,
        edit_errors: @todo_edit_errors || {},
        edit_values: @todo_edit_values || {} %>
    </section>

    <aside class="space-y-8" aria-label="Workspace utilities">
      <%= render "counter", counter: @counter %>
      <%= render "activity", activities: @activities %>
    </aside>
  </div>

  <section class="mt-8 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="catalog-heading">
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-cyan-700">Resource library</p>
        <h2 id="catalog-heading" class="mt-2 text-2xl font-bold tracking-tight text-slate-950">Find the next team accelerator</h2>
      </div>
      <p class="max-w-md text-sm leading-6 text-slate-500">Search and category state is submitted to Rails; Turbo replaces only this explorer.</p>
    </div>

    <%= render "products",
      products: @products,
      search_query: @search_query,
      selected_category: @selected_category,
      categories: RailsFirstDemoController::PRODUCT_CATEGORIES %>
  </section>
</div>
