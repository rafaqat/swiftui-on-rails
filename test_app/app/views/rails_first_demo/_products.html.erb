<section id="rails-products" aria-label="Resource search" aria-live="polite">
  <%= form_with url: rails_first_demo_search_path, method: :post, id: "product-search-form", class: "grid gap-3 rounded-2xl bg-slate-50 p-4 md:grid-cols-[minmax(0,1fr)_12rem_auto]" do |form| %>
    <div>
      <%= form.label :search, "Search resources", class: "sr-only" %>
      <%= form.search_field :search,
        value: search_query,
        maxlength: RailsFirstDemoController::MAX_SEARCH_LENGTH,
        placeholder: "Search books, courses, and tools…",
        class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm shadow-sm outline-none placeholder:text-slate-400 focus:border-cyan-600 focus:ring-4 focus:ring-cyan-100" %>
    </div>
    <div>
      <%= form.label :category, "Resource category", class: "sr-only" %>
      <%= form.select :category,
        options_for_select(categories.map { |category| [category == "all" ? "All categories" : category.titleize, category] }, selected_category),
        {},
        class: "w-full rounded-xl border border-slate-300 bg-white px-3 py-3 text-sm font-semibold text-slate-700 shadow-sm outline-none focus:border-cyan-600 focus:ring-4 focus:ring-cyan-100" %>
    </div>
    <%= form.submit "Explore",
      class: "cursor-pointer rounded-xl bg-cyan-700 px-5 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-cyan-800 focus:outline-none focus:ring-4 focus:ring-cyan-200" %>
  <% end %>

  <div class="mt-5 flex items-center justify-between gap-4">
    <p class="text-sm font-semibold text-slate-600">
      <%= pluralize(products.length, "resource") %>
      <% if search_query.present? %>
        matching “<%= search_query %>”
      <% end %>
    </p>
    <% if search_query.present? || selected_category != "all" %>
      <%= link_to "Clear filters", rails_first_demo_path(anchor: "rails-products"), class: "text-sm font-bold text-cyan-700 hover:text-cyan-900" %>
    <% end %>
  </div>

  <% if products.any? %>
    <div class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      <% products.each do |product| %>
        <article id="product-<%= product[:id] %>" class="group overflow-hidden rounded-2xl border border-slate-200 bg-white transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-lg">
          <div class="h-2 bg-gradient-to-r <%= product[:accent] %>" aria-hidden="true"></div>
          <div class="p-5">
            <div class="flex items-start justify-between gap-4">
              <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[0.68rem] font-bold uppercase tracking-wider text-slate-600"><%= product[:category] %></span>
              <p class="text-lg font-black text-slate-950"><%= number_to_currency(product[:price], precision: 0) %></p>
            </div>
            <h3 class="mt-4 text-base font-bold text-slate-950"><%= product[:name] %></h3>
            <p class="mt-2 text-sm leading-6 text-slate-500"><%= product[:description] %></p>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="mt-4 rounded-2xl border border-dashed border-slate-300 px-6 py-12 text-center">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-100 text-xl" aria-hidden="true">⌕</div>
      <h3 class="mt-4 text-base font-bold text-slate-900">No matching resources</h3>
      <p class="mt-1 text-sm text-slate-500">Try a broader search or choose another category.</p>
    </div>
  <% end %>
</section>
