<% content_for :title, "RPN Scientific Calculator · SwiftUI Rails Showcase" %>

<% content_for :head do %>
  <style>
    :root {
      --calc-ink: #172026;
      --calc-shell: #20282e;
      --calc-shell-edge: #0c1115;
      --calc-display: #c9d5b0;
      --calc-display-ink: #172219;
      --calc-gold: #e9b949;
      --calc-blue: #6db2d5;
      --calc-cream: #f4f0e5;
    }

    body:has(.calculator-page) {
      background:
        radial-gradient(circle at 10% 5%, rgba(233, 185, 73, .16), transparent 28rem),
        radial-gradient(circle at 90% 38%, rgba(109, 178, 213, .12), transparent 30rem),
        #eef1f2;
      color: var(--calc-ink);
    }

    body:has(.calculator-page) main {
      display: block;
      max-width: none;
      margin-top: 0;
      padding: 0;
    }

    .calculator-page {
      min-height: 100vh;
      width: 100%;
      overflow: hidden;
      padding: clamp(1.25rem, 4vw, 4rem);
    }

    .calculator-page__header {
      width: min(76rem, 100%);
      margin: 0 auto clamp(2rem, 5vw, 4rem);
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 2rem;
    }

    .calculator-page__eyebrow {
      margin: 0 0 .65rem;
      color: #8b5f08;
      font: 700 .75rem/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: .18em;
      text-transform: uppercase;
    }

    .calculator-page h1 {
      max-width: 14ch;
      margin: 0;
      font: 750 clamp(2.4rem, 7vw, 5.75rem)/.91 ui-sans-serif, system-ui, sans-serif;
      letter-spacing: -.065em;
    }

    .calculator-page__intro {
      max-width: 32rem;
      margin: 0 0 .35rem;
      color: #53616a;
      font-size: 1rem;
      line-height: 1.75;
    }

    .calculator-page__stage {
      width: min(76rem, 100%);
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(18rem, 34rem) minmax(17rem, 1fr);
      gap: clamp(2rem, 6vw, 6rem);
      align-items: center;
    }

    .calculator-page__notes {
      display: grid;
      gap: 1.1rem;
    }

    .calculator-note {
      display: grid;
      grid-template-columns: 2.6rem 1fr;
      gap: 1rem;
      padding: 1.2rem;
      border: 1px solid rgba(23, 32, 38, .11);
      border-radius: 1rem;
      background: rgba(255, 255, 255, .62);
      box-shadow: 0 1rem 3rem rgba(39, 50, 57, .04);
      backdrop-filter: blur(12px);
    }

    .calculator-note__number {
      width: 2.6rem;
      height: 2.6rem;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: var(--calc-ink);
      color: white;
      font: 700 .78rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    }

    .calculator-note h2 {
      margin: 0 0 .3rem;
      font-size: .96rem;
      letter-spacing: -.01em;
    }

    .calculator-note p {
      margin: 0;
      color: #647078;
      font-size: .86rem;
      line-height: 1.55;
    }

    .calculator-shortcuts {
      padding: 1rem 1.2rem;
      border-left: 3px solid var(--calc-gold);
      color: #59666e;
      font-size: .82rem;
      line-height: 1.7;
    }

    .calculator-shortcuts kbd {
      padding: .12rem .38rem;
      border: 1px solid #b8c0c4;
      border-bottom-width: 2px;
      border-radius: .3rem;
      background: #fff;
      color: #263138;
      font: 700 .72rem/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
    }

    .calculator {
      position: relative;
      padding: clamp(1rem, 3vw, 1.55rem);
      border: 1px solid #4b565d;
      border-radius: 1.7rem 1.7rem 2.2rem 2.2rem;
      background:
        linear-gradient(105deg, rgba(255, 255, 255, .08), transparent 14%, transparent 80%, rgba(0, 0, 0, .14)),
        repeating-linear-gradient(90deg, rgba(255, 255, 255, .012) 0, rgba(255, 255, 255, .012) 1px, transparent 1px, transparent 4px),
        var(--calc-shell);
      box-shadow:
        0 2.2rem 4.5rem rgba(21, 28, 33, .28),
        inset 0 1px rgba(255, 255, 255, .2),
        inset 0 -6px rgba(0, 0, 0, .16);
      color: white;
    }

    .calculator::after {
      content: "";
      position: absolute;
      inset: auto 12% -.8rem;
      height: 1.2rem;
      z-index: -1;
      border-radius: 50%;
      background: rgba(19, 24, 27, .32);
      filter: blur(12px);
    }

    .calculator__brand {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: .1rem .2rem .8rem;
    }

    .calculator__brand-name {
      font: 750 .72rem/1 ui-sans-serif, system-ui, sans-serif;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    .calculator__model {
      padding: .28rem .5rem;
      border: 1px solid rgba(255, 255, 255, .2);
      border-radius: .35rem;
      color: var(--calc-gold);
      font: 700 .63rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: .08em;
    }

    .calculator__display-bezel {
      padding: .62rem;
      border: 1px solid #080b0d;
      border-radius: .75rem;
      background: #101619;
      box-shadow: inset 0 2px 5px #000, 0 1px rgba(255, 255, 255, .13);
    }

    .calculator__display {
      min-height: 10.2rem;
      padding: .9rem 1rem .75rem;
      overflow: hidden;
      border-radius: .35rem;
      background:
        linear-gradient(rgba(255, 255, 255, .12), transparent 35%),
        repeating-linear-gradient(0deg, rgba(22, 34, 25, .025) 0, rgba(22, 34, 25, .025) 1px, transparent 1px, transparent 3px),
        var(--calc-display);
      box-shadow: inset 0 0 1.4rem rgba(54, 73, 54, .2);
      color: var(--calc-display-ink);
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-variant-numeric: tabular-nums;
    }

    .calculator__annunciators {
      min-height: 1rem;
      display: flex;
      gap: .55rem;
      margin-bottom: .35rem;
      color: #506154;
      font-size: .58rem;
      font-weight: 800;
      letter-spacing: .09em;
    }

    .calculator__annunciator--active { color: #15231a; }

    .calculator__stack-row {
      min-width: 0;
      display: grid;
      grid-template-columns: 1rem 1fr;
      align-items: baseline;
      gap: .5rem;
      color: #3f5144;
      font-size: .77rem;
      line-height: 1.35;
    }

    .calculator__stack-label {
      font-size: .57rem;
      font-weight: 800;
    }

    .calculator__stack-value {
      overflow: hidden;
      text-align: right;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .calculator__stack-row--x {
      margin-top: .2rem;
      color: #101c14;
      font-size: clamp(1.45rem, 5vw, 2.15rem);
      line-height: 1.08;
      letter-spacing: -.04em;
    }

    .calculator__status {
      min-height: 1rem;
      margin-top: .55rem;
      overflow: hidden;
      color: #4a5c4f;
      font-size: .56rem;
      font-weight: 700;
      letter-spacing: .04em;
      text-overflow: ellipsis;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .calculator__status--error { color: #8a2119; }
    .calculator__status--pending { color: #775006; }

    .calculator__registers {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: .25rem;
      margin: .7rem .1rem .9rem;
    }

    .calculator__register {
      min-width: 0;
      padding: .26rem .2rem;
      border-radius: .25rem;
      background: rgba(4, 8, 10, .24);
      color: #aeb9bf;
      font: 600 .5rem/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
      text-align: center;
    }

    .calculator__register-value {
      display: block;
      overflow: hidden;
      color: #e7ecef;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .calculator__keypad {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-rows: repeat(7, minmax(2.35rem, auto));
      gap: clamp(.36rem, 1.3vw, .55rem);
    }

    .calculator__key {
      position: relative;
      min-width: 0;
      min-height: 2.35rem;
      padding: .42rem .1rem;
      border: 1px solid #070a0c;
      border-radius: .42rem .42rem .55rem .55rem;
      background: linear-gradient(#4d5960, #2a3338 70%);
      box-shadow: 0 3px 0 #090c0e, inset 0 1px rgba(255, 255, 255, .22);
      color: #fff;
      cursor: pointer;
      font: 750 clamp(.62rem, 1.7vw, .78rem)/1 ui-sans-serif, system-ui, sans-serif;
      touch-action: manipulation;
      transition: transform 70ms ease, box-shadow 70ms ease, filter 100ms ease;
    }

    .calculator__key:hover { filter: brightness(1.12); }
    .calculator__key:focus-visible { outline: 3px solid var(--calc-blue); outline-offset: 2px; }
    .calculator__key:active,
    .calculator__key.is-keyboard-active {
      transform: translateY(2px);
      box-shadow: 0 1px 0 #090c0e, inset 0 1px rgba(255, 255, 255, .12);
    }

    .calculator__key--science {
      color: #101619;
      background: linear-gradient(#d6dadd, #aeb7bc 72%);
    }

    .calculator__key--mode {
      color: #1a2931;
      background: linear-gradient(#9bcbe1, #6299b3 72%);
    }

    .calculator__key--mode-active {
      box-shadow: 0 3px 0 #090c0e, inset 0 0 0 2px #d8f2ff;
    }

    .calculator__key--memory {
      color: #201803;
      background: linear-gradient(#f2ca6d, #c9972e 72%);
    }

    .calculator__key--danger {
      color: #fff;
      background: linear-gradient(#b55b50, #7d2f28 72%);
    }

    .calculator__key--operator {
      color: #161b1e;
      background: linear-gradient(#f8f5eb, #cbc6b8 72%);
      font-size: 1rem;
    }

    .calculator__key--zero { grid-column: 1 / span 2; grid-row: 7; }
    .calculator__key--decimal { grid-column: 3; grid-row: 7; }
    .calculator__key--plus { grid-column: 4; grid-row: 7; }
    .calculator__key--enter {
      grid-column: 5 / span 2;
      grid-row: 6 / span 2;
      color: #1d1707;
      background: linear-gradient(#f4cf73, #c99830 72%);
      font-size: .72rem;
      letter-spacing: .06em;
    }

    .calculator.is-submitting .calculator__key { pointer-events: none; }

    @media (max-width: 820px) {
      .calculator-page__header { display: block; }
      .calculator-page__intro { margin-top: 1.25rem; }
      .calculator-page__stage { grid-template-columns: 1fr; }
      .calculator-page__notes { grid-template-columns: repeat(2, 1fr); }
      .calculator-shortcuts { grid-column: 1 / -1; }
      .calculator { width: min(34rem, 100%); margin: 0 auto; }
    }

    @media (max-width: 520px) {
      .calculator-page { padding: 1rem .65rem 2.5rem; }
      .calculator-page__header { padding: 0 .45rem; }
      .calculator-page__notes { grid-template-columns: 1fr; }
      .calculator-shortcuts { grid-column: auto; }
      .calculator { border-radius: 1.15rem 1.15rem 1.5rem 1.5rem; }
      .calculator__registers { grid-template-columns: repeat(5, 1fr); }
      .calculator__keypad { gap: .34rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      .calculator__key { transition: none; }
    }
  </style>
<% end %>

<section class="calculator-page">
  <header class="calculator-page__header">
    <div>
      <p class="calculator-page__eyebrow">Interactive systems demo / 01</p>
      <h1>Scientific thinking, stacked.</h1>
    </div>
    <p class="calculator-page__intro">
      A server-backed reverse Polish notation calculator with a four-level stack,
      scientific functions, memory registers, Turbo updates, and native keyboard-accessible controls.
    </p>
  </header>

  <div class="calculator-page__stage">
    <%= render "showcase/calculator/calculator", calculator: @calculator %>

    <aside class="calculator-page__notes" aria-label="Calculator capabilities">
      <article class="calculator-note">
        <span class="calculator-note__number">01</span>
        <div>
          <h2>True four-level RPN</h2>
          <p>Type a value, press ENTER, type the next value, then choose an operation. Watch X, Y, Z, and T move in real time.</p>
        </div>
      </article>
      <article class="calculator-note">
        <span class="calculator-note__number">02</span>
        <div>
          <h2>Scientific and precise</h2>
          <p>Switch DEG/RAD modes, enter exponents with EEX, and use powers, roots, logarithms, trigonometry, and ten memory registers.</p>
        </div>
      </article>
      <article class="calculator-note">
        <span class="calculator-note__number">03</span>
        <div>
          <h2>Rails state, browser speed</h2>
          <p>The calculation engine is pure Ruby. Each key is validated server-side and the display is replaced with a compact Turbo Stream response.</p>
        </div>
      </article>
      <p class="calculator-shortcuts">
        Keyboard: <kbd>Tab</kbd> and <kbd>Shift</kbd>+<kbd>Tab</kbd> move between keys;
        <kbd>Enter</kbd> or <kbd>Space</kbd> presses the focused key.
      </p>
    </aside>
  </div>
</section>
