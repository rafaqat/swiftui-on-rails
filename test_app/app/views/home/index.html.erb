<% content_for :title, "Showcase · SwiftUI Rails" %>

<div class="min-h-screen w-full bg-[#f6f3eb] text-slate-950">
  <header class="relative overflow-hidden border-b border-slate-900/10 bg-slate-950 text-white">
    <div class="absolute inset-0 opacity-50" aria-hidden="true">
      <div class="absolute -left-28 top-16 h-80 w-80 rounded-full bg-violet-600/50 blur-3xl"></div>
      <div class="absolute -right-20 -top-20 h-96 w-96 rounded-full bg-cyan-500/30 blur-3xl"></div>
    </div>

    <div class="relative mx-auto grid max-w-7xl gap-14 px-6 py-20 lg:grid-cols-[1.25fr_0.75fr] lg:items-end lg:py-28">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.34em] text-cyan-300">Rails rendered · SwiftUI inspired</p>
        <h1 class="mt-5 max-w-4xl text-5xl font-black leading-[0.96] tracking-tight sm:text-7xl">
          Complete interfaces,<br>
          <span class="bg-gradient-to-r from-cyan-300 via-white to-violet-300 bg-clip-text text-transparent">built the Rails way.</span>
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-300">
          Explore production-shaped demos with server-owned state, declared RenderIR interactions, keyed updates, and reusable SwiftUI-style Ruby components—not a gallery of static mockups or application JavaScript.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <%= link_to "Explore flagship demos", "#flagship-demos", class: "rounded-full bg-white px-6 py-3 text-sm font-black text-slate-950 transition hover:bg-cyan-200" %>
          <%= link_to "Browse the demo gallery →", demos_path, class: "rounded-full border border-white/20 bg-white/5 px-6 py-3 text-sm font-black text-white transition hover:border-emerald-300 hover:bg-white/10" %>
          <%= link_to "Open component lab →", rails_stories_path, class: "rounded-full border border-white/20 bg-white/5 px-6 py-3 text-sm font-black text-white transition hover:border-violet-300 hover:bg-white/10" %>
        </div>
      </div>

      <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-white/10 bg-white/10 shadow-2xl">
        <div class="bg-slate-950/80 p-6">
          <dt class="text-xs font-bold uppercase tracking-widest text-slate-400">Flagship apps</dt>
          <dd class="mt-3 text-4xl font-black text-cyan-300">6</dd>
        </div>
        <div class="bg-slate-950/80 p-6">
          <dt class="text-xs font-bold uppercase tracking-widest text-slate-400">Curated labs</dt>
          <dd class="mt-3 text-4xl font-black text-violet-300"><%= StoryCatalog.entries.length %></dd>
        </div>
        <div class="col-span-2 bg-slate-950/80 p-6">
          <dt class="text-xs font-bold uppercase tracking-widest text-slate-400">Interaction model</dt>
          <dd class="mt-3 flex items-center gap-3 text-lg font-black">
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-400 shadow-[0_0_18px_rgba(52,211,153,0.9)]"></span>
            Real workflows, live state
          </dd>
        </div>
      </dl>
    </div>
  </header>

  <div class="mx-auto max-w-7xl px-6 py-16">
    <section id="flagship-demos" aria-labelledby="flagship-heading">
      <div class="grid gap-6 lg:grid-cols-[0.7fr_1.3fr] lg:items-end">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.3em] text-violet-700">Flagship demos</p>
          <h2 id="flagship-heading" class="mt-3 text-4xl font-black tracking-tight sm:text-5xl">Try the whole workflow.</h2>
        </div>
        <p class="max-w-2xl text-lg leading-8 text-slate-600 lg:justify-self-end">
          Each experience exercises a different application shape: live code and fixture editing, an integrated command deck, precise keyboard input, a transactional cart, conventional Rails CRUD, and signed real-time operations.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <%= link_to showcase_playground_path, class: "group relative min-h-96 overflow-hidden rounded-[2rem] bg-[#1f2229] p-8 text-white shadow-xl transition hover:-translate-y-1 hover:shadow-2xl md:col-span-2", data: { showcase_card: "playground" } do %>
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(56,189,248,0.16),transparent_38%),radial-gradient(circle_at_bottom_right,rgba(99,102,241,0.18),transparent_42%)]"></div>
          <div class="relative grid h-full gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:items-end">
            <div class="flex h-full flex-col">
              <div class="flex items-center justify-between">
                <span class="rounded-full border border-cyan-300/25 bg-cyan-300/10 px-3 py-1 text-xs font-black uppercase tracking-widest text-cyan-200">Live developer tool</span>
                <span class="text-3xl transition group-hover:translate-x-1">↗</span>
              </div>
              <div class="mt-auto pt-16">
                <h3 class="text-4xl font-black sm:text-5xl">SwiftUI Rails Playground</h3>
                <p class="mt-4 max-w-xl text-lg leading-8 text-slate-300">Edit real SwiftUI-style Ruby, shape JSON fixtures beside it, and see a safe live canvas with diagnostics, device previews, and render metrics.</p>
              </div>
            </div>

            <div class="overflow-hidden rounded-2xl border border-white/10 bg-[#101216] shadow-2xl" aria-hidden="true">
              <div class="flex items-center gap-2 border-b border-white/10 px-4 py-3">
                <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span><span class="h-2.5 w-2.5 rounded-full bg-amber-300"></span><span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
                <span class="ml-3 font-mono text-[10px] tracking-widest text-slate-500">ProductCard.rb · Live Preview</span>
              </div>
              <div class="grid min-h-56 grid-cols-[1.05fr_0.95fr]">
                <pre class="overflow-hidden border-r border-white/10 p-4 font-mono text-[11px] leading-6 text-slate-300"><span class="text-violet-300">vstack</span>(alignment: <span class="text-cyan-300">:leading</span>) do
  <span class="text-violet-300">text</span>(product[<span class="text-cyan-300">:name</span>])
  <span class="text-amber-200">if</span> product[<span class="text-cyan-300">:in_stock</span>]
    <span class="text-violet-300">badge</span>(<span class="text-emerald-300">"In Stock"</span>)
  <span class="text-amber-200">end</span>
<span class="text-amber-200">end</span></pre>
                <div class="grid place-items-center bg-slate-100 p-4 text-slate-950">
                  <div class="w-full rounded-2xl bg-white p-4 shadow-lg">
                    <div class="h-20 rounded-xl bg-gradient-to-br from-cyan-400 to-violet-500"></div>
                    <p class="mt-3 font-black">Orbit Keyboard</p>
                    <span class="mt-2 inline-flex rounded-full bg-green-50 px-2 py-1 text-[10px] font-bold text-green-800">In Stock</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <%= link_to showcase_mission_control_path, class: "group relative min-h-96 overflow-hidden rounded-[2rem] bg-[#06101f] p-8 text-white shadow-xl transition hover:-translate-y-1 hover:shadow-2xl md:col-span-2", data: { showcase_card: "mission-control" } do %>
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(56,189,248,0.22),transparent_42%),radial-gradient(circle_at_bottom_left,rgba(139,92,246,0.18),transparent_38%)]"></div>
          <div class="relative grid h-full gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
            <div class="flex h-full flex-col">
              <div class="flex items-center justify-between">
                <span class="rounded-full border border-sky-300/25 bg-sky-300/10 px-3 py-1 text-xs font-black uppercase tracking-widest text-sky-200">Integrated DSL showcase</span>
                <span class="text-3xl transition group-hover:translate-x-1">↗</span>
              </div>
              <div class="mt-auto pt-16">
                <h3 class="text-4xl font-black sm:text-5xl">Atlas Mission Control</h3>
                <p class="mt-4 max-w-xl text-lg leading-8 text-slate-300">Navigate a live command deck with telemetry, orbital visuals, a reorderable flight plan, swipe actions, focus-aware presentations, and signed document workflows.</p>
              </div>
            </div>

            <div class="grid gap-3 rounded-3xl border border-white/10 bg-white/5 p-5 shadow-2xl" aria-hidden="true">
              <div class="flex items-center justify-between border-b border-white/10 pb-4">
                <div class="flex gap-2"><span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span><span class="h-2.5 w-2.5 rounded-full bg-cyan-300"></span><span class="h-2.5 w-2.5 rounded-full bg-violet-400"></span></div>
                <span class="font-mono text-xs tracking-[0.24em] text-sky-200">ATLAS // ORBIT NOMINAL</span>
              </div>
              <div class="grid grid-cols-3 gap-3">
                <% [["ALT", "408 km"], ["VEL", "7.66 km/s"], ["LINK", "99.97%"]].each do |label, value| %>
                  <div class="rounded-2xl bg-slate-950/70 p-4">
                    <p class="text-xs font-bold tracking-widest text-slate-500"><%= label %></p>
                    <p class="mt-3 font-mono text-lg font-black text-cyan-200"><%= value %></p>
                  </div>
                <% end %>
              </div>
              <div class="relative h-32 overflow-hidden rounded-2xl bg-slate-950/70">
                <div class="absolute left-1/2 top-1/2 h-16 w-16 -translate-x-1/2 -translate-y-1/2 rounded-full border border-cyan-300/40 shadow-[0_0_45px_rgba(34,211,238,0.25)]"></div>
                <div class="absolute left-1/2 top-1/2 h-24 w-64 -translate-x-1/2 -translate-y-1/2 rotate-[-8deg] rounded-[50%] border border-violet-300/30"></div>
                <div class="absolute left-[73%] top-[37%] h-3 w-3 rounded-full bg-cyan-200 shadow-[0_0_16px_rgba(165,243,252,0.95)]"></div>
              </div>
            </div>
          </div>
        <% end %>

        <%= link_to showcase_calculator_path, class: "group relative min-h-96 overflow-hidden rounded-[2rem] bg-[#2b2823] p-8 text-[#f6e5bd] shadow-xl transition hover:-translate-y-1 hover:shadow-2xl", data: { showcase_card: "calculator" } do %>
          <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-amber-300/10 blur-3xl"></div>
          <div class="relative flex h-full flex-col">
            <div class="flex items-center justify-between">
              <span class="rounded-full border border-amber-100/20 bg-black/20 px-3 py-1 text-xs font-black uppercase tracking-widest">Scientific tools</span>
              <span class="text-3xl transition group-hover:translate-x-1">↗</span>
            </div>
            <div class="mt-14 rounded-2xl border border-amber-100/10 bg-[#171612] p-5 shadow-inner">
              <p class="font-mono text-xs tracking-[0.3em] text-amber-200/55">RPN · RAD · 4 LEVEL STACK</p>
              <p class="mt-5 overflow-hidden text-right font-mono text-5xl tracking-tight text-emerald-300">3.14159265</p>
            </div>
            <div class="mt-auto pt-8">
              <h3 class="text-3xl font-black">Classic RPN Calculator</h3>
              <p class="mt-3 max-w-md leading-7 text-amber-50/70">An HP-inspired scientific instrument with a four-level stack, keyboard controls, memory, angle modes, and persisted tape.</p>
            </div>
          </div>
        <% end %>

        <%= link_to showcase_commerce_path, class: "group relative min-h-96 overflow-hidden rounded-[2rem] bg-[#c8ff45] p-8 text-slate-950 shadow-xl transition hover:-translate-y-1 hover:shadow-2xl", data: { showcase_card: "commerce" } do %>
          <div class="absolute -bottom-28 -right-20 h-80 w-80 rounded-full border-[48px] border-slate-950/5"></div>
          <div class="relative flex h-full flex-col">
            <div class="flex items-center justify-between">
              <span class="rounded-full border border-slate-950/15 bg-white/30 px-3 py-1 text-xs font-black uppercase tracking-widest">Transactional flow</span>
              <span class="text-3xl transition group-hover:translate-x-1">↗</span>
            </div>
            <div class="mt-12 grid grid-cols-3 gap-3" aria-hidden="true">
              <div class="h-28 rotate-[-4deg] rounded-2xl bg-orange-500 shadow-lg"></div>
              <div class="h-28 translate-y-4 rounded-2xl bg-violet-600 shadow-lg"></div>
              <div class="h-28 rotate-[4deg] rounded-2xl bg-cyan-500 shadow-lg"></div>
            </div>
            <div class="mt-auto pt-10">
              <h3 class="text-3xl font-black">Northstar Commerce</h3>
              <p class="mt-3 max-w-md leading-7 text-slate-800">Browse a catalog, inspect products, manage quantities, see server-calculated totals, and complete checkout.</p>
            </div>
          </div>
        <% end %>

        <%= link_to rails_first_demo_path, class: "group relative min-h-96 overflow-hidden rounded-[2rem] bg-white p-8 text-slate-950 shadow-xl ring-1 ring-slate-900/10 transition hover:-translate-y-1 hover:shadow-2xl", data: { showcase_card: "rails-workspace" } do %>
          <div class="relative flex h-full flex-col">
            <div class="flex items-center justify-between">
              <span class="rounded-full bg-rose-100 px-3 py-1 text-xs font-black uppercase tracking-widest text-rose-700">Rails-first CRUD</span>
              <span class="text-3xl transition group-hover:translate-x-1">↗</span>
            </div>
            <div class="mt-12 space-y-3 rounded-2xl bg-slate-100 p-5" aria-hidden="true">
              <div class="flex items-center gap-3 rounded-xl bg-white p-3 shadow-sm"><span class="h-5 w-5 rounded-md bg-emerald-500"></span><span class="h-3 w-3/4 rounded-full bg-slate-200"></span></div>
              <div class="flex items-center gap-3 rounded-xl bg-white p-3 shadow-sm"><span class="h-5 w-5 rounded-md border-2 border-slate-300"></span><span class="h-3 w-2/3 rounded-full bg-slate-200"></span></div>
              <div class="flex items-center gap-3 rounded-xl bg-white p-3 shadow-sm"><span class="h-5 w-5 rounded-md border-2 border-slate-300"></span><span class="h-3 w-1/2 rounded-full bg-slate-200"></span></div>
            </div>
            <div class="mt-auto pt-8">
              <h3 class="text-3xl font-black">Project Workspace</h3>
              <p class="mt-3 max-w-md leading-7 text-slate-600">Create, edit, search, complete, and remove tasks through ordinary controller actions and Turbo Stream responses.</p>
            </div>
          </div>
        <% end %>

        <%= link_to showcase_operations_path, class: "group relative min-h-96 overflow-hidden rounded-[2rem] bg-[#071b1b] p-8 text-white shadow-xl transition hover:-translate-y-1 hover:shadow-2xl", data: { showcase_card: "operations" } do %>
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-emerald-300 to-transparent"></div>
          <div class="relative flex h-full flex-col">
            <div class="flex items-center justify-between">
              <span class="rounded-full border border-emerald-300/20 bg-emerald-300/10 px-3 py-1 text-xs font-black uppercase tracking-widest text-emerald-300">Signed live stream</span>
              <span class="text-3xl transition group-hover:translate-x-1">↗</span>
            </div>
            <div class="mt-12 grid grid-cols-3 gap-3" aria-hidden="true">
              <% ["99.98%", "142ms", "2.4k"].each do |metric| %>
                <div class="rounded-2xl border border-emerald-100/10 bg-white/5 p-4">
                  <div class="h-1.5 w-8 rounded-full bg-emerald-400"></div>
                  <p class="mt-5 font-mono text-lg font-black text-emerald-100"><%= metric %></p>
                </div>
              <% end %>
            </div>
            <div class="mt-auto pt-8">
              <h3 class="text-3xl font-black">Operations Control Room</h3>
              <p class="mt-3 max-w-md leading-7 text-slate-300">Deploy, scale, recover, and declare incidents while signed Action Cable broadcasts keep every view current.</p>
            </div>
          </div>
        <% end %>
      </div>
    </section>

    <section class="mt-20 overflow-hidden rounded-[2rem] bg-violet-700 text-white" aria-labelledby="lab-heading">
      <div class="grid lg:grid-cols-[1fr_0.8fr]">
        <div class="p-9 sm:p-12">
          <p class="text-xs font-black uppercase tracking-[0.3em] text-violet-200">Component lab</p>
          <h2 id="lab-heading" class="mt-3 text-4xl font-black tracking-tight">Go beneath the applications.</h2>
          <p class="mt-5 max-w-xl text-lg leading-8 text-violet-100">The curated Storybook exposes source-backed variants, real controls, layout systems, authentication patterns, and composition primitives.</p>
          <%= link_to "Browse #{StoryCatalog.entries.length} curated labs →", rails_stories_path, class: "mt-8 inline-flex rounded-full bg-white px-6 py-3 text-sm font-black text-violet-800 transition hover:bg-cyan-200" %>
        </div>
        <div class="grid grid-cols-2 gap-px bg-white/10 p-px">
          <%= link_to "Stateless patterns", stateless_demo_path, class: "flex min-h-36 items-end bg-violet-800 p-6 text-lg font-black transition hover:bg-violet-900" %>
          <%= link_to "Counter internals", counter_path, class: "flex min-h-36 items-end bg-violet-800 p-6 text-lg font-black transition hover:bg-violet-900" %>
          <%= link_to "Product layouts", catalog_products_path, class: "col-span-2 flex min-h-36 items-end bg-violet-800 p-6 text-lg font-black transition hover:bg-violet-900" %>
        </div>
      </div>
    </section>
  </div>
</div>
