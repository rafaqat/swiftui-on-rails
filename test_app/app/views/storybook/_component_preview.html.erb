<% begin %>
  <% if defined?(component_instance) && component_instance %>
    <% story_result = component_instance %>
  <% else %>
    <% renderer = StoryRenderer.new(controller) %>
    <% selected_variant = if story_variant && available_stories.include?(story_variant)
         story_variant
       elsif available_stories.include?(:default)
         :default
       else
         available_stories.first
       end %>
    <% story_result = renderer.render_story(
         story_instance,
         selected_variant,
         **component_props
       ) %>
  <% end %>

  <% if story_result.is_a?(ViewComponent::Base) %>
    <%= render story_result %>
  <% else %>
    <%= story_result %>
  <% end %>
<% rescue StandardError => e %>
  <% Rails.logger.error "Component preview rendering failed: #{e.class}: #{e.message}\n#{Array(e.backtrace).first(10).join("\n")}" %>
  <div class="rounded-2xl border border-rose-200 bg-rose-50 p-5 text-rose-800" role="alert">
    <p class="font-semibold">Unable to render component preview.</p>
    <p class="mt-2 text-sm">Check the server logs for details.</p>
  </div>
<% end %>
