<% content_for :title, "#{@story_name} · Component Lab" %>
<% story_name = @story_name %>
<% story_key = @story_key %>
<% story_variant = @story_variant %>
<% session_id = @session_id %>
<% story_config = @story_config %>
<% component_props = @component_props %>
<% available_stories = @available_stories %>
<% state_data = @state_data %>
<% component_class = @component_class %>
<% component_instance = @component_instance %>
<% story_instance = @story_instance %>
<% dsl_story = @dsl_story %>
<% story_source_path = @story_source_path %>
<% story_source_code = @story_source_code %>

<%= swift_ui do
  section(id: "storybook-preview-page", class: "min-h-screen bg-slate-50 text-slate-950") do
    header(class: "border-b border-slate-200 bg-white") do
      div(class: "mx-auto flex max-w-7xl flex-col gap-6 px-6 py-8 lg:flex-row lg:items-end lg:justify-between") do
        vstack(alignment: :start, spacing: 8) do
          a("← Component Lab", href: rails_stories_path)
            .tw("text-sm font-black text-violet-700 hover:text-violet-900")
          h1(story_name).tw("text-4xl font-black tracking-tight")
          p("A Rails-owned preview: URL props, server state, and declared SwiftUI Rails actions.")
            .tw("max-w-3xl text-sm font-medium text-slate-500")
        end

        hstack(spacing: 8, alignment: :center) do
          span("Server rendered")
            .tw("rounded-full bg-emerald-100 px-3 py-1 text-xs font-black uppercase tracking-wider text-emerald-800")
          span(story_variant.to_s.humanize)
            .tw("rounded-full bg-violet-100 px-3 py-1 text-xs font-black uppercase tracking-wider text-violet-800")
        end
      end
    end

    div(class: "mx-auto grid max-w-7xl gap-8 px-6 py-10 lg:grid-cols-[20rem_minmax(0,1fr)]") do
      aside(class: "space-y-6") do
        section(class: "rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-900/10") do
          h2("Preview Controls").tw("text-xl font-black")
          p("Change values, then submit one explicit Rails transition.")
            .tw("mt-2 text-sm leading-6 text-slate-500")

          form(
            action: story_path(story: story_key),
            method: "get",
            data: { turbo_frame: "_top" },
            class: "mt-6 space-y-5",
            id: "storybook-controls"
          ) do
            input(type: "hidden", name: "story_variant", value: story_variant)

            story_config.fetch(:controls).each do |key, control|
              control_id = "storybook-control-#{key}"

              div(class: "space-y-2") do
                hstack(spacing: 6, alignment: :center) do
                  label(key.to_s.humanize, for_input: control_id)
                    .tw("text-sm font-black text-slate-800")
                  spacer
                  span(control.fetch(:type).to_s)
                    .tw("rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-slate-500")
                end

                case control[:type]
                when :text
                  input(
                    id: control_id,
                    type: "text",
                    name: key,
                    value: component_props[key],
                    placeholder: "Enter #{key.to_s.humanize.downcase}"
                  ).tw("w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm focus:border-violet-600 focus:outline-none")
                when :select
                  select(id: control_id, name: key, selected: component_props[key]) do
                    Array(control[:options]).each do |option_value|
                      option(
                        option_value.to_s,
                        option_value.to_s.presence&.humanize || "Default",
                        selected: option_value.to_s == component_props[key].to_s
                      )
                    end
                  end.tw("w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm focus:border-violet-600 focus:outline-none")
                when :number
                  input(
                    id: control_id,
                    type: "number",
                    name: key,
                    value: component_props[key],
                    min: control[:min],
                    max: control[:max],
                    step: control[:step] || 1
                  ).tw("w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm focus:border-violet-600 focus:outline-none")
                when :boolean
                  input(type: "hidden", name: key, value: "0")
                  label(for_input: control_id, class: "flex cursor-pointer items-center gap-3 rounded-xl bg-slate-50 px-3 py-2") do
                    input(
                      id: control_id,
                      type: "checkbox",
                      name: key,
                      value: "1",
                      checked: component_props[key]
                    ).tw("h-4 w-4 rounded border-slate-300 text-violet-600 focus:ring-violet-600")
                    span(component_props[key] ? "Enabled" : "Disabled")
                      .tw("text-sm font-bold text-slate-700")
                  end
                end

                text("Current: #{component_props[key].inspect}")
                  .tw("block font-mono text-xs text-slate-400")
              end
            end

            hstack(spacing: 8, alignment: :center) do
              button("Apply controls", type: "submit")
                .tw("rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-black text-white hover:bg-violet-700")
              a("Reset", href: story_path(story: story_key, story_variant: story_variant))
                .tw("rounded-xl px-4 py-2.5 text-sm font-black text-slate-600 hover:bg-slate-100")
            end
          end
        end

        if available_stories.size > 1
          nav(aria: { label: "Story variants" }, class: "rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-900/10") do
            h2("Variants").tw("text-sm font-black uppercase tracking-widest text-slate-500")
            vstack(alignment: :stretch, spacing: 4, class: "mt-4") do
              available_stories.each do |variant|
                active = variant == story_variant
                attrs = {
                  href: story_path(story: story_key, story_variant: variant),
                  class: "rounded-xl px-3 py-2 text-sm font-bold #{active ? 'bg-violet-100 text-violet-900' : 'text-slate-600 hover:bg-slate-100'}",
                  data: { variant: variant }
                }
                attrs[:aria] = { current: "page" } if active
                a(variant.to_s.humanize, **attrs)
              end
            end
          end
        end

        section(id: "state-inspector", class: "rounded-3xl bg-slate-950 p-6 text-white") do
          h2("Server State").tw("text-sm font-black uppercase tracking-widest text-cyan-300")
          p("The inspector is rendered from the same Rails state as the preview.")
            .tw("mt-2 text-xs leading-5 text-slate-400")

          vstack(alignment: :stretch, spacing: 6, class: "mt-4") do
            if state_data.empty?
              text("No props or state declared.").tw("text-sm text-slate-400")
            else
              state_data.each do |name, value|
                div(class: "grid grid-cols-[minmax(0,1fr)_auto] gap-3 border-t border-white/10 pt-2") do
                  text(name.to_s).tw("truncate font-mono text-xs text-slate-400")
                  text(value.inspect).tw("max-w-36 break-all text-right font-mono text-xs text-white")
                end
              end
            end
          end

          text("Session #{session_id.first(8)}…")
            .tw("mt-4 block border-t border-white/10 pt-3 font-mono text-[10px] text-slate-500")
        end
      end

      vstack(alignment: :stretch, spacing: 24) do
        section(class: "overflow-hidden rounded-3xl bg-white shadow-xl ring-1 ring-slate-900/10") do
          header(class: "flex items-center justify-between bg-slate-950 px-6 py-4 text-white") do
            h2("Preview").tw("text-lg font-black")
            text("GET #{story_key}/#{story_variant}")
              .tw("font-mono text-xs text-slate-400")
          end

          div(
            id: "component-preview",
            class: "min-h-[28rem] overflow-auto p-8",
            data: {
              sui_story_session: session_id,
              sui_story: story_key,
              sui_story_variant: story_variant
            }
          ) do
            render(
              partial: "storybook/component_preview",
              locals: {
                component_class: component_class,
                component_instance: component_instance,
                component_props: component_props,
                story_instance: story_instance,
                story_variant: story_variant,
                available_stories: available_stories
              }
            )
          end
        end

        section(class: "rounded-3xl bg-white p-8 shadow-sm ring-1 ring-slate-900/10") do
          h2(dsl_story ? "DSL Story Source" : "Component Definition")
            .tw("text-xl font-black")

          if story_source_code
            p("Durable source from #{story_source_path.basename}.")
              .tw("mt-2 text-sm text-slate-500")
            div(
              tabindex: "0",
              aria: { label: "Scrollable story source" },
              class: "mt-5 max-h-[36rem] overflow-auto rounded-2xl bg-slate-950 p-5 text-slate-100"
            ) do
              text(story_source_code)
                .tw("whitespace-pre font-mono text-xs leading-5")
            end
          elsif component_class
            p("#{component_class.name} < #{component_class.superclass.name}")
              .tw("mt-3 font-mono text-sm text-slate-600")
          else
            p("This story is rendered directly from its registered variant.")
              .tw("mt-3 text-sm text-slate-500")
          end
        end
      end
    end
  end
end %>
