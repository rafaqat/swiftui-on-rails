<% content_for :title, "Component Lab · SwiftUI Rails" %>
<% stories = @stories %>
<% variant_total = stories.sum { |story| story[:variants].length } %>

<%= swift_ui do
  section(id: "storybook-catalog", class: "min-h-screen bg-slate-50 text-slate-950") do
    header(class: "overflow-hidden bg-slate-950 text-white") do
      div(class: "mx-auto grid max-w-7xl gap-10 px-6 py-16 lg:grid-cols-[1.5fr_1fr] lg:items-end") do
        vstack(alignment: :start, spacing: 12) do
          a("← Showcase", href: root_path)
            .tw("text-sm font-black text-cyan-300 hover:text-cyan-200")
          text("Rails-owned component lab")
            .tw("mt-6 text-xs font-black uppercase tracking-[0.35em] text-violet-300")
          h1("Inspect the system, not screenshots.")
            .tw("max-w-4xl text-5xl font-black tracking-tight sm:text-6xl")
          p("Submit real props, navigate source-backed variants, and inspect server state without creating a second JavaScript application.")
            .tw("max-w-3xl text-lg leading-8 text-slate-300")
        end

        grid(columns: 3, spacing: 12) do
          [
            ["Curated labs", stories.length],
            ["Variants", variant_total],
            ["State owner", "Rails"]
          ].each do |label_text, value|
            div(class: "rounded-2xl border border-white/10 bg-white/5 p-4") do
              text(label_text).tw("block text-xs uppercase tracking-wider text-slate-400")
              text(value.to_s).tw("mt-2 block text-3xl font-black")
            end
          end
        end
      end
    end

    div(class: "mx-auto max-w-7xl px-6 py-12") do
      if flash[:alert]
        div(flash[:alert], role: "alert", class: "mb-8 rounded-xl border border-rose-300 bg-rose-50 px-4 py-3 text-rose-800")
      end

      stories.group_by { |story| story[:category] }.each do |category, category_stories|
        section(class: "mb-14", aria: { labelledby: "#{category.parameterize}-stories" }) do
          div(class: "mb-6 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between") do
            div do
              text(category).tw("text-xs font-black uppercase tracking-[0.25em] text-violet-600")
              h2(
                category == "Flagship" ? "Complete interface compositions" : "#{category} explorations",
                id: "#{category.parameterize}-stories"
              ).tw("mt-1 text-3xl font-black tracking-tight")
            end
            text(pluralize(category_stories.sum { |story| story[:variants].length }, "source-backed variant"))
              .tw("text-sm text-slate-500")
          end

          div(class: "grid gap-6 md:grid-cols-2 #{category == 'Flagship' ? 'xl:grid-cols-2' : 'xl:grid-cols-3'}") do
            category_stories.each do |story|
              article(
                class: "group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl",
                data: { story_key: story[:path] }
              ) do
                div(class: "bg-gradient-to-r #{story[:accent]} p-6 text-white") do
                  hstack(spacing: 12, alignment: :start) do
                    vstack(alignment: :start, spacing: 4) do
                      text(story[:category]).tw("text-xs font-bold uppercase tracking-[0.25em] text-white/75")
                      h3(story[:name]).tw("text-2xl font-black")
                    end
                    spacer
                    text(pluralize(story[:variants].length, "variant"))
                      .tw("rounded-full border border-white/20 bg-white/10 px-3 py-1 text-xs font-bold")
                  end
                end

                div(class: "p-6") do
                  p(story[:description]).tw("min-h-16 leading-7 text-slate-600")

                  div(class: "mt-5 flex min-h-16 flex-wrap content-start gap-2", aria: { label: "Available variants" }) do
                    story[:variants].first(4).each do |variant|
                      text(variant.to_s.humanize)
                        .tw("rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600")
                    end
                    if story[:variants].length > 4
                      text("+#{story[:variants].length - 4} more")
                        .tw("rounded-full bg-violet-50 px-2.5 py-1 text-xs font-bold text-violet-700")
                    end
                  end

                  hstack(spacing: 12, alignment: :center, class: "mt-6 border-t border-slate-100 pt-5") do
                    text(story[:file].basename.to_s).tw("font-mono text-xs text-slate-400")
                    spacer
                    a(
                      "Open preview →",
                      href: story_path(story: story[:path], story_variant: story[:default_variant])
                    ).tw("rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-bold text-white transition group-hover:bg-violet-600")
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end %>
