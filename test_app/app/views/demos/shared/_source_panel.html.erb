<%# Collapsible DSL source for the demo's backing component. Native
    <details> — no JavaScript required. Expects demo_source => [path, code]. %>
<% source_path, source_code = demo_source %>
<details class="mt-4">
  <summary class="cursor-pointer text-sm font-black text-slate-950 transition hover:text-violet-700">
    View DSL source · <%= source_path.basename %>
  </summary>
  <pre aria-label="Scrollable demo source" class="mt-3 max-h-[32rem] overflow-auto rounded-2xl bg-slate-950 p-5 text-xs leading-5 text-slate-100"><code><%= source_code %></code></pre>
</details>
