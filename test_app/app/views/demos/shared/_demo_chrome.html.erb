<%# Shared frame for every /demos page. Render with a block:
      render layout: "demos/shared/demo_chrome" do ... end
    Expects demo_metadata (helper from Demos::BaseController). %>
<div class="min-h-screen w-full bg-[#f6f3eb] text-slate-950">
  <header class="border-b border-slate-900/10 bg-white">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-4 px-6 py-5">
      <%= link_to "← All demos", demos_path, class: "text-sm font-black text-slate-500 transition hover:text-slate-950" %>
      <h1 class="text-xl font-black tracking-tight"><%= demo_metadata[:name] %></h1>
      <span class="rounded-full bg-slate-950 px-3 py-1 text-xs font-black uppercase tracking-widest text-white">
        <%= DemoCatalog.model_label(demo_metadata[:model]) %>
      </span>
      <div class="ml-auto flex items-center gap-3">
        <%= render CommandPaletteComponent.new(commands: DemoCatalog.palette_commands(self)) %>
        <% if demo_metadata[:story] %>
          <%= link_to "Storybook →", story_path(story: demo_metadata[:story]), class: "text-sm font-black text-violet-700 transition hover:text-violet-900" %>
        <% end %>
      </div>
    </div>
  </header>

  <%# Toast stack: full-page flashes render here directly; Turbo Stream
      responses append into it via Demos::BaseController#toast_stream. %>
  <div id="toasts" class="pointer-events-none fixed right-6 top-20 z-50 flex flex-col gap-3">
    <% if flash[:notice].present? %>
      <%= render ToastComponent.new(message: flash[:notice], variant: "success") %>
    <% end %>
    <% if flash[:alert].present? %>
      <%= render ToastComponent.new(message: flash[:alert], variant: "error") %>
    <% end %>
  </div>

  <main class="mx-auto max-w-7xl px-6 py-10">
    <%= yield %>
  </main>

  <footer class="mx-auto max-w-7xl px-6 pb-14">
    <div class="rounded-3xl bg-white p-6 shadow ring-1 ring-slate-900/10">
      <p class="text-xs font-black uppercase tracking-widest text-slate-400">Interaction model</p>
      <p class="mt-2 text-sm leading-6 text-slate-600"><%= demo_metadata[:description] %></p>
      <%= render "demos/shared/source_panel" if demo_source %>
    </div>
  </footer>
</div>
